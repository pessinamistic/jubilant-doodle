ent_progress", "label": "Phase 4: Agent progress (optional)", "file_type": "rationale", "source_file": "docs/model-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional, ~0.5 day: InfrastructureTools.pullModel emits progress through the same ModelDashboardService progress map so an in-flight agent pull is visible in the Runtime UI; kept confirmation-gated since already classified WRITE in AgentSafety."}, {"id": "model_management_plan_pullstreaming_method", "label": "OllamaModelPuller.pullStreaming", "file_type": "code", "source_file": "docs/model-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "model_management_plan_parseprogressline", "label": "parseProgressLine(String) -> PullProgress", "file_type": "code", "source_file": "docs/model-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "model_management_plan_pull_progress_dto", "label": "PullProgress", "file_type": "code", "source_file": "docs/model-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "model_management_plan_modelruntimecontroller_stream_endpoint", "label": "GET /models/runtime/pull/stream", "file_type": "code", "source_file": "docs/model-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "model_management_plan_pullruntimemodelstream_client_fn", "label": "pullRuntimeModelStream (client.js SSE fn)", "file_type": "code", "source_file": "docs/model-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "model_management_plan_agentchatcontroller_pattern", "label": "AgentChatController (SSE pattern reference)", "file_ty