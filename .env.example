# Port Wrangler — environment configuration
# Copy this file to .env and adjust; docker compose loads .env automatically,
# and the setup/update/cleanup scripts read it too. Every value is optional —
# the defaults below work out of the box.

# ============================================================
# Network binding & ports
# ============================================================

# Interface published ports bind to. 127.0.0.1 keeps everything loopback-only
# (default); use 0.0.0.0 to expose Port Wrangler on your LAN.
# APP_BIND=127.0.0.1

# Local domain served by Caddy. Must match your /etc/hosts entry —
# start_macos_setup.sh keeps them in sync.
# PORTWRANGLER_DOMAIN=portwrangler.local

# Caddy HTTP port (http://portwrangler.local). 80 keeps the URL clean.
# HTTP_PORT=80

# Direct backend API port (bypasses Caddy). Deliberately NOT 8080 so that
# port stays free for tools deployed through Port Wrangler.
# API_PORT=8590

# Direct frontend UI port (bypasses Caddy).
# UI_PORT=8591

# Host port of the auto-provisioned pgvector system DB (dbdeployer-system-db).
# SYSTEM_DB_PORT=5499

# ============================================================
# AI / LLM
# ============================================================

# Ollama base URL as seen FROM INSIDE the app container. The default reaches
# an Ollama on the Docker host (native install or host-published container).
# OLLAMA_BASE_URL=http://host.docker.internal:11434
